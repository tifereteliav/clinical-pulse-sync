rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // החידון החי: מצב המשחק, השחקנים והתשובות
    match /quiz/{doc} {
      allow read, write: if true;
    }
    match /quizSessions/{sid}/{document=**} {
      allow read, write: if true;
    }
    // הסקר הישן (/poll, /admin, /live)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
